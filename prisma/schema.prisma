generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

model Organization {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  tier            String    @default("free")
  maxLeadsPerDay  Int       @default(50)
  maxAiTokensPerMonth BigInt @default(1000000)
  classificationModel  String  @default("gpt-4o-mini")
  personalizationModel String  @default("gpt-4o")
  serviceOffering     String?
  uniqueValue         String?
  positioningPrompt   String?
  users           User[]
  leads           Lead[]
  campaigns       Campaign[]
  icpProfiles     ICPProfile[]
  promptConfigs   PromptConfig[]
  messages        Message[]
  conversations   Conversation[]
  analyticsEvents AnalyticsEvent[]
  usageRecords    UsageRecord[]
  reportArtifacts ReportArtifact[]
  campaignRunLogs    CampaignRunLog[]
  gmapsScrapeRunLogs GmapsScrapeRunLog[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String?
  role            String    @default("member")
  supabaseUserId  String    @unique
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([organizationId])
}

model Lead {
  id              String    @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  externalId      String?
  source          String
  sourceUrl       String?
  sourceType      String    @default("intent")
  name            String
  headline        String?
  bio             String?
  role            String?
  company         String?
  companySize     String?
  industry        String?
  location        String?
  email           String?
  phone           String?
  website         String?
  originalContent String?
  intentType      String?
  intentUrgency   String?
  intentConfidence Float?
  isBuyer         Boolean   @default(false)
  intentReasoning String?
  painPoints      Json?
  fears           Json?
  desires         Json?
  budgetSignal    String?
  hiringIntent    Boolean   @default(false)
  icpAttributes   Json?
  companyStage    String?
  technicalLevel  String?
  score           Int       @default(0)
  scoreBreakdown  Json?
  tier            String    @default("COLD")
  personalizationData Json?
  personalContext Json?
  psychology      Json?
  positioning     Json?
  toneProfile     String?
  recommendedChannel String?
  placeId         String?
  rating          Float?
  reviewCount     Int?
  businessType    String?
  businessHours   Json?
  lastReviewAt    DateTime?
  googleTypes     Json?
  websiteAudit    Json?
  socialHandles   Json?
  enrichmentStatus String?
  status          String    @default("NEW")
  consentBasis    String    @default("LEGITIMATE_INTEREST")
  optedOut        Boolean   @default(false)
  optedOutAt      DateTime?
  dataExpiresAt   DateTime?
  contentHash     String?
  campaign        Campaign?  @relation(fields: [campaignId], references: [id])
  campaignId      String?
  messages        Message[]
  conversations   Conversation[]
  reportArtifacts ReportArtifact[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@unique([externalId, source, organizationId])
  @@index([organizationId, tier, status])
  @@index([organizationId, score])
  @@index([organizationId, source])
  @@index([contentHash, organizationId])
}

model Message {
  id              String    @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId          String
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  campaignId      String?
  channel         String
  subject         String?
  body            String
  type            String    @default("OUTREACH")
  personalContext Json?
  status          String    @default("DRAFT")
  spamScore       Float?
  uniquenessScore Float?
  burntPatterns   Json?
  promptConfigId  String?
  promptVersion   String?
  aiModel         String?
  aiTokensUsed    Int?
  approvedBy      String?
  approvedAt      DateTime?
  sentAt          DateTime?
  repliedAt       DateTime?
  generatedAt     DateTime  @default(now())
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([organizationId, status])
  @@index([leadId])
  @@index([campaignId])
}

model Conversation {
  id              String    @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId          String
  channel         String    @default("linkedin-dm")
  messages        Json      @default("[]")
  messageCount    Int       @default(0)
  lastMessageAt   DateTime  @default(now())
  suggestedReply  String?
  objectionType   String?
  sentiment       String?
  closingStrategy String?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([organizationId, status])
  @@index([leadId])
}

model Campaign {
  id              String    @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  name            String
  description     String?
  icpProfileId    String?
  icpProfile      ICPProfile? @relation(fields: [icpProfileId], references: [id])
  settings        Json?
  icpConfig       Json?
  keywords        Json?
  sources         Json?
  targetLocations Json?
  targetIndustries Json?
  scoringWeights  Json?
  positioningPrompt String?
  promptConfigId  String?
  promptConfig    PromptConfig? @relation(fields: [organizationId, promptConfigId], references: [organizationId, id])
  promptOverrides Json?
  leadsGenerated  Int       @default(0)
  messagesSent    Int       @default(0)
  replies         Int       @default(0)
  meetings        Int       @default(0)
  conversions     Int       @default(0)
  leads           Lead[]
  messages        Message[]
  reportArtifacts ReportArtifact[]
  scrapeCursors      CampaignScrapeCursor[]
  campaignRunLogs    CampaignRunLog[]
  gmapsScrapeRunLogs GmapsScrapeRunLog[]
  maxLeadsPerRun  Int?
  isActive        Boolean   @default(true)
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([organizationId, status])
  @@index([promptConfigId])
}

model CampaignScrapeCursor {
  id                   String    @id @default(uuid())
  campaign             Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId           String
  source               String
  queryKey             String
  lastRunAt            DateTime?
  lastScrollSteps      Int       @default(8)
  totalSeen            Int       @default(0)
  lastNewCount         Int       @default(0)
  consecutiveZeroRuns  Int       @default(0)
  lastNewLeadAt        DateTime?
  exhausted            Boolean   @default(false)
  seenExternalIds      String[]  @default([])
  lastScrollDepth      Int       @default(0)
  duplicateWallHits    Int       @default(0)
  // Fast-scroll resume fields (Phase 1 — populated, Phase 2 — consumed by probe)
  tailIds              String[]  @default([])  // last 80 listing keys observed in DOM
  anchorPlaceId        String?                 // listing key of last NEW lead from previous run
  keyword              String?                 // plaintext for debugging (not the hashed queryKey)
  industry             String?
  location             String?
  lastEndReason        String?
  fastScrollBudgetUsed Int       @default(0)
  fastScrollLastUsed   Int       @default(0)
  fastScrollHitRate    Float?
  // Reconciliation fields (Phase 3)
  archived             Boolean   @default(false)
  archivedAt           DateTime?
  archivedReason       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  @@unique([campaignId, source, queryKey])
  @@index([campaignId, source])
  @@index([campaignId, archived])
}

model ReportArtifact {
  id              String       @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId          String
  campaign        Campaign?    @relation(fields: [campaignId], references: [id])
  campaignId      String?
  kind            String
  version         Int          @default(1)
  body            String       @db.Text
  metadata        Json
  generatedBy     String?
  generatedAt     DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@unique([leadId, kind, version])
  @@index([organizationId, leadId])
  @@index([leadId, kind])
}

model PromptConfig {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  campaigns       Campaign[]

  // Library metadata
  name            String
  description     String?
  status          String  @default("active")

  // Positioning
  companyDescription   String?
  coreOffer            String?
  targetPersona        String?
  mainPainSolved       String?
  mainOutcomePromised  String?
  proofPoints          Json?

  // Voice & CTA
  preferredTone             String  @default("professional")
  customToneInstructions    String?
  ctaStyle                  String  @default("reply_question")
  customCta                 String?

  // Guardrails
  forbiddenPhrases  Json?
  forbiddenClaims   Json?
  complianceNotes   String?

  // System prompt overrides (replaces base prompts entirely)
  personalizationPromptOverride  String?
  outreachPromptOverride         String?

  // Versioning
  version  Int   @default(1)
  history  Json?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([organizationId, status])
  @@unique([organizationId, id])
}

model ICPProfile {
  id              String    @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  name            String
  version         Int       @default(1)
  config          Json?
  targetRoles     Json?
  targetIndustries Json?
  targetStages    Json?
  targetLocations Json?
  buyerSignals    Json?
  urgencySignals  Json?
  budgetSignals   Json?
  learnedWeights  Json?
  conversionRate  Float?
  isActive        Boolean   @default(true)
  campaigns       Campaign[]
  changeLog       ICPProfileChangeLog[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([organizationId, isActive])
}

model ICPProfileChangeLog {
  id             String     @id @default(uuid())
  profile        ICPProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId      String
  organizationId String
  changedAt      DateTime   @default(now())
  changedBy      String?
  fieldName      String
  beforeValue    Json?
  afterValue     Json?
  fromVersion    Int
  toVersion      Int
  @@index([profileId, changedAt])
  @@index([organizationId, fieldName, changedAt])
}

model AnalyticsEvent {
  id              String    @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  eventType       String
  leadId          String?
  campaignId      String?
  data            Json?
  entityType      String?
  entityId        String?
  metadata        Json?
  occurredAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  @@index([organizationId, eventType, createdAt])
  @@index([leadId])
}

model UsageRecord {
  id              String    @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  date            DateTime  @db.Date
  aiTokensUsed    BigInt    @default(0)
  aiCostCents     Int       @default(0)
  leadsProcessed  Int       @default(0)
  scrapeRequests  Int       @default(0)
  scrapesExecuted Int       @default(0)
  apiCallsMade    Int       @default(0)
  updatedAt       DateTime  @updatedAt
  @@unique([organizationId, date])
  @@index([organizationId, date])
}

model LinkedInRun {
  id               String    @id @default(cuid())
  runId            String    @unique
  organizationId   String
  campaignId       String?
  startedAt        DateTime
  completedAt      DateTime?
  durationMs       Int
  totalYielded     Int
  extractionRate   Float
  rateLimitRate    Float
  healthy          Boolean
  healthReason     String?
  selectorVersion  Int
  perKeyword       Json
  errors           Json
  createdAt        DateTime  @default(now())
  @@index([organizationId, startedAt])
}

model CampaignRunLog {
  id                    String   @id @default(cuid())
  runId                 String   @unique
  campaignId            String
  organizationId        String
  trigger               String
  startedAt             DateTime @default(now())
  completedAt           DateTime?
  durationMs            Int?
  status                String   @default("RUNNING")
  goalMaxLeads          Int
  reachedGoal           Boolean  @default(false)
  endReason             String?
  adaptersAttempted     String[] @default([])
  adaptersUsed          String[] @default([])
  adaptersSkipped       Json     @default("[]")
  candidatesYielded     Int      @default(0)
  duplicatesAtAdapter   Int      @default(0)
  duplicatesAtIngestion Int      @default(0)
  newLeadsSaved         Int      @default(0)
  enqueuedToPipeline    Int      @default(0)
  errors                Int      @default(0)
  errorSummary          Json?
  metadata              Json?
  campaign              Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, startedAt])
  @@index([campaignId, startedAt])
  @@index([status])
}

model GmapsScrapeRunLog {
  id                     String   @id @default(cuid())
  runId                  String
  campaignId             String
  organizationId         String
  queryKey               String
  searchTerm             String
  startedAt              DateTime @default(now())
  completedAt            DateTime?
  durationMs             Int?
  scrollAttempts         Int      @default(0)
  candidateUrlsCollected Int      @default(0)
  cursorCacheHits        Int      @default(0)
  dbBatchDuplicates      Int      @default(0)
  extractionFailures     Int      @default(0)
  candidatesExtracted    Int      @default(0)
  ingestionDuplicates    Int      @default(0)
  newLeadsSaved          Int      @default(0)
  endReason              String?  @default("RUNNING")
  errorSummary           String?
  metadata               Json?
  campaign               Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, startedAt])
  @@index([campaignId, queryKey])
  @@index([runId])
}
