# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=3000
APP_NAME=lead-generation-engine

# ============================================================
# Tenant Mode
# ============================================================
# Options: single | multi
TENANT_MODE=single
DEFAULT_ORGANIZATION_ID=default

# ============================================================
# Database (Supabase / PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ============================================================
# Supabase
# ============================================================
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================
# Redis (Upstash)
# ============================================================
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# JWT Authentication
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ============================================================
# API Keys
# ============================================================
API_KEY_HEADER=x-api-key
INTERNAL_API_KEY=your-internal-api-key

# ============================================================
# AI Providers
# ============================================================
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...
ANTHROPIC_API_KEY=sk-ant-...

# Default models
AI_CLASSIFICATION_MODEL=gpt-4o-mini
AI_PERSONALIZATION_MODEL=gpt-4o
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=30000

# ============================================================
# Scoring Thresholds
# ============================================================
SCORE_HOT_THRESHOLD=20
SCORE_WARM_THRESHOLD=10

# ============================================================
# Scraping / Rate Limiting
# ============================================================
SCRAPING_CONCURRENT_LIMIT=5
SCRAPING_DELAY_MS=1000
SCRAPING_TIMEOUT_MS=30000
SCRAPING_RETRY_ATTEMPTS=3

# ============================================================
# Queue Configuration (BullMQ)
# ============================================================
QUEUE_INTENT_NAME=intent
QUEUE_ENRICH_NAME=enrich
QUEUE_SCORE_NAME=score
QUEUE_PERSONALIZE_NAME=personalize
QUEUE_OUTREACH_NAME=outreach
QUEUE_DEFAULT_CONCURRENCY=5
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=5000

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# Data Retention
# ============================================================
DATA_RETENTION_DAYS=90

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=debug
LOG_FORMAT=json
